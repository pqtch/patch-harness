#!/usr/bin/env bash
# check-types — the frontmatter `type:` check.
#
# RULED: `type:` has exactly TWO closed vocabularies, and everywhere else
# it is free text. The survey that produced the ruling found 14 distinct values in the tree,
# which looked like drift and was not — it was three vocabularies of which only two were ever
# written down, plus decoration.
#
# The test that decided which ones are real: DOES ANYTHING BEHAVE DIFFERENTLY BASED ON THE
# VALUE?
#   agent-memory  yes — the MEMORY.md index column, and memory-rules.md's write-gate tests
#   a NOTE        yes — the type decides WHERE the file lands (templates/README.md)
#   everything else  no. `type: design` on a design doc has never routed anything.
#
# So this checks those two and is deliberately silent about the rest. Closing a vocabulary
# nothing reads would be enforcing tidiness, not correctness.
#
# ASYMMETRY, stated because it is load-bearing: the memory vocabulary is ENFORCED — a lane
# file must carry one of four values. The note vocabulary is NOT, and cannot be: a note is
# identified by its own frontmatter, so an illegal note type looks exactly like a legal
# free-text type on a non-note. What is checked about notes instead is under vocabulary B.
#
# NEVER fails its caller — a warning, not a gate. Always exits 0, same rule as check-pointers.
set -u

# ROOT defaults to this workspace, derived from the script's own location; pass a dir to override.
ROOT="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)}"

MEM_OK="identity feedback project reference"

in_set() { case " $2 " in *" $1 "*) return 0;; *) return 1;; esac; }

main() {
  cd "$ROOT" 2>/dev/null || return 0

  local bad=0 out="" f t

  # ── vocabulary A: memory lanes ──────────────────────────────────────────────
  while IFS= read -r f; do
    case "$f" in */MEMORY.md|*/README.md|*/LAST.md) continue;; esac  # indexes, docs and the LAST brief are not memories
    t="$(sed -n 's/^type: *//p' "$f" | head -1)"
    # Diagnose the harness format specifically. Claude Code injects its own memory-writing
    # instructions specifying `metadata:` with a nested `type:` — and naming the first type
    # `user` where memory-rules.md names it `identity`. A memory written by following those
    # instructions verbatim lands in that shape, so this WILL recur; say what it is rather
    # than reporting a missing field. This workspace uses the FLAT form (MEMORY.tmp.md).
    if [ -z "$t" ] && grep -q '^metadata:' "$f" 2>/dev/null; then
      bad=$((bad+1)); out="$out\n  $f — nested metadata.type (harness format). Flatten to a top-level \`type:\`."; continue
    fi
    [ -n "$t" ] || { bad=$((bad+1)); out="$out\n  $f — no type: (memory lane requires one of: $MEM_OK)"; continue; }
    in_set "$t" "$MEM_OK" || { bad=$((bad+1)); out="$out\n  $f — type: $t (memory lane allows: $MEM_OK)"; }
  done < <(find .claude/agent-memory -name '*.md' -type f 2>/dev/null)

  # ── vocabulary B: notes ─────────────────────────────────────────────────────
  # A NOTE is identified by its own frontmatter, not its path — notes live wherever their
  # subject lives. That has a consequence this check states plainly instead of papering over:
  # an ILLEGAL note type is indistinguishable from a legal free-text type on a file that is
  # not a note, so `type: banana` cannot be reported, and is not.
  #
  # A previous revision pretended otherwise. It filtered to the four legal values and then
  # tested membership in the same four, so the branch could never fire — the check printed
  # "vocabularies OK" while examining nothing. Found 2026-09-11 by planting `type: bogus-kind`
  # and watching nothing happen; docs/incidents.md #6 is the same shape, twice now.
  #
  # What IS checkable about a note is checked, and nothing else:
  #   1. an UNFILLED mold — `type:` still carrying the `<angle bracket>` placeholder.
  #   2. `## Measured` on a type other than `finding`. templates/README.md makes that section
  #      finding-only and the other three molds say to delete it.
  while IFS= read -r f; do
    case "$f" in .claude/agent-memory/*|.claude/templates/*|_ops/archive/*|*-repo/*) continue;; esac
    t="$(sed -n 's/^type: *//p' "$f" | head -1)"
    [ -n "$t" ] || continue
    case "$t" in
      *'<'*'>'*)
        bad=$((bad+1)); out="$out\n  $f — type: $t (unfilled mold placeholder — pick one value)"; continue ;;
    esac
    case "$t" in
      lesson|reference|note)
        if grep -q '^## Measured' "$f" 2>/dev/null; then
          bad=$((bad+1)); out="$out\n  $f — type: $t carries a '## Measured' section, which is \`finding\`-only (delete it)"
        fi ;;
    esac
  done < <(find . -name '*.md' -type f -not -path './.git/*' 2>/dev/null | sed 's|^\./||')

  if [ "$bad" -eq 0 ]; then
    echo "check-types: type: vocabularies OK."
  else
    echo "check-types: $bad file(s) to fix:"
    printf "%b\n" "$out"
  fi
  return 0
}

main
exit 0
